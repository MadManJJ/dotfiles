{
    "layer": "bottom",
    "position": "top",
    "height": 10,
    "spacing": 0,
    "modules-left": ["sway/workspaces","sway/mode"],
    "modules-center": ["custom/clock"],
    "modules-right": ["sway/language", "pulseaudio", "temperature", "cpu", "memory", "battery", "custom/lid-mode", "custom/notification", "tray"],

    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{icon}{name}",
        "format-icons": {
            "default": " ",
            "urgent": "!",
            "focused": "*"
        }
    },

    "sway/mode": {
        "format": "  {}"
    },

    "custom/clock": {
        "format": "<span color='#252525'>[ </span>{text}<span color='#252525'> ]</span>",
        "exec": "date +'%H:%M %A, %b %d' | awk '{print tolower($0)}'",
        "interval": 3
    },

    "sway/language": {
        "format": "<span color='#252525'>[ </span><span color='#afa193'><b>key: </b></span>{short}<span color='#252525'> / </span>",
        "tooltip": false
    },

    "pulseaudio": {
        "format": "<span color='#afa193'><b>vol:</b></span> {volume}%",
        "format-muted": "<span color='#afa193'><b>vol:</b></span> {volume}% (m)",
	"on-click": "sh -c 'pidof pavucontrol && pkill pavucontrol || pavucontrol'"
    },

    "cpu": {
	"format": "<span color='#252525'> / </span><span color='#afa193'><b>cpu:</b></span> {usage}%",
	"interval": 5,
    },

    "memory": {
        "format": "<span color='#252525'> / </span><span color='#afa193'><b>mem:</b></span> {percentage}%",
        "interval": 5,
	"tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB\nSwap: {swapUsed:0.1f}GiB / {swapTotal:0.1f}GiB"
    },
    
    "battery": {
        "format": "<span color='#252525'> / </span><span color='#afa193'><b>bat:</b></span> {capacity}%<span color='#252525'> ] </span>",
        "format-charging": "<span color='#252525'> / </span><span color='#afa193'><b>ac:</b></span> {capacity}%<span color='#252525'> ] </span>",
        "tooltip": false,
        "interval": 20
    },
    
    "tray": {
        "icon-size": 20,
        "spacing": 7,
        "tooltip": false
    },

    "temperature": {
        "critical-threshold": 80,
        "format": "<span color='#252525'> / </span><span color='#afa193'><b>temp:</b></span> {temperatureC}°C",
        "format-critical": "<span color='#252525'> / </span><span color='#ff0000'><b>temp:</b></span> {temperatureC}°C",
        "interval": 5
    },
    
    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "<span foreground='red'><sup></sup></span>",
            "none": "",
            "dnd-notification": "<span foreground='red'><sup></sup></span>",
            "dnd-none": "",
            "inhibited-notification": "<span foreground='red'><sup></sup></span>",
            "inhibited-none": "",
            "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
            "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "sleep 0.1 && swaync-client -t -sw",
        "on-click-right": "sleep 0.1 && swaync-client -d -sw",
        "escape": true
    },

    "custom/lid-mode": {
      "exec": "~/.config/waybar/scripts/lid-mode.sh",
      "on-click": "~/.config/waybar/scripts/lid-mode.sh toggle",
      "return-type": "json",
      "interval": 3
    }
}
